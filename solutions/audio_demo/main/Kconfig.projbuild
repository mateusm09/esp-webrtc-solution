menu "Wifi Configuration"
    config WIFI_STATION_SSID
        string "WiFi Station SSID"
        default "ssid"
        help
            The SSID of the WiFi network to connect to.

    config WIFI_STATION_PASSWORD
        string "WiFi Station Password"
        default "pass"
        help
            The password of the WiFi network to connect to.
endmenu
menu "MQTT Configuration"
    config MQTT_BROKER
        string "MQTT Broker"
        default "broker"
        help
            The MQTT broker to connect to.
    config MQTT_USER
        string "MQTT username"
        default "user"
        help
            The username to connect to the MQTT broker.
    config MQTT_PASS
        string "MQTT password"
        default "pass"
        help
            The password to connect to the MQTT broker.

endmenu